<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="4.0" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd">
  <display-name>Grievance Campus</display-name>
  <session-config><session-timeout>30</session-timeout><cookie-config><http-only>true</http-only></cookie-config><tracking-mode>COOKIE</tracking-mode></session-config>
  <welcome-file-list><welcome-file>index.jsp</welcome-file></welcome-file-list>
  <error-page><error-code>404</error-code><location>/error.jsp</location></error-page><error-page><error-code>500</error-code><location>/error.jsp</location></error-page>
  <filter><filter-name>authentication</filter-name><filter-class>com.grievancecampus.filter.AuthenticationFilter</filter-class></filter>
  <filter-mapping><filter-name>authentication</filter-name><url-pattern>/app/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>authentication</filter-name><url-pattern>/student/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>authentication</filter-name><url-pattern>/teacher/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>authentication</filter-name><url-pattern>/hod/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>authentication</filter-name><url-pattern>/staff/*</url-pattern></filter-mapping>
  <filter-mapping><filter-name>authentication</filter-name><url-pattern>/admin/*</url-pattern></filter-mapping>
  <filter><filter-name>encoding</filter-name><filter-class>com.grievancecampus.filter.EncodingFilter</filter-class></filter><filter-mapping><filter-name>encoding</filter-name><url-pattern>/*</url-pattern></filter-mapping>
  <servlet><servlet-name>login</servlet-name><servlet-class>com.grievancecampus.servlet.LoginServlet</servlet-class></servlet><servlet-mapping><servlet-name>login</servlet-name><url-pattern>/login</url-pattern></servlet-mapping>
  <servlet><servlet-name>studentRegistration</servlet-name><servlet-class>com.grievancecampus.servlet.StudentRegistrationServlet</servlet-class></servlet><servlet-mapping><servlet-name>studentRegistration</servlet-name><url-pattern>/register</url-pattern></servlet-mapping>
  <servlet><servlet-name>logout</servlet-name><servlet-class>com.grievancecampus.servlet.LogoutServlet</servlet-class></servlet><servlet-mapping><servlet-name>logout</servlet-name><url-pattern>/logout</url-pattern></servlet-mapping>
  <servlet><servlet-name>dashboard</servlet-name><servlet-class>com.grievancecampus.servlet.DashboardServlet</servlet-class></servlet><servlet-mapping><servlet-name>dashboard</servlet-name><url-pattern>/app/dashboard</url-pattern></servlet-mapping>
  <servlet><servlet-name>grievance</servlet-name><servlet-class>com.grievancecampus.servlet.GrievanceServlet</servlet-class></servlet><servlet-mapping><servlet-name>grievance</servlet-name><url-pattern>/app/grievances</url-pattern></servlet-mapping>
  <servlet><servlet-name>assignment</servlet-name><servlet-class>com.grievancecampus.servlet.AssignmentServlet</servlet-class></servlet><servlet-mapping><servlet-name>assignment</servlet-name><url-pattern>/app/assignments</url-pattern></servlet-mapping>
  <servlet><servlet-name>photo</servlet-name><servlet-class>com.grievancecampus.servlet.PhotoServlet</servlet-class></servlet><servlet-mapping><servlet-name>photo</servlet-name><url-pattern>/app/photo</url-pattern></servlet-mapping>
  <servlet><servlet-name>users</servlet-name><servlet-class>com.grievancecampus.servlet.UserManagementServlet</servlet-class></servlet><servlet-mapping><servlet-name>users</servlet-name><url-pattern>/app/users</url-pattern></servlet-mapping>
  <servlet><servlet-name>grievanceDetails</servlet-name><servlet-class>com.grievancecampus.servlet.GrievanceDetailsServlet</servlet-class></servlet><servlet-mapping><servlet-name>grievanceDetails</servlet-name><url-pattern>/app/grievance-details</url-pattern></servlet-mapping>
</web-app>
