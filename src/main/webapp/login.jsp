<%@ page contentType="text/html;charset=UTF-8" %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sign in · Grievance Campus</title><link rel="stylesheet" href="assets/css/style.css"><link rel="stylesheet" href="assets/css/auth.css"></head><body class="auth-page"><main class="auth-card"><a class="brand" href="index.jsp"><span class="brand-mark">G</span><span>Grievance Campus<small>Student support portal</small></span></a><h1>Welcome back</h1><p class="muted">Sign in to follow and resolve campus concerns.</p><% if("1".equals(request.getParameter("registered"))){ %><div class="notice" role="status">Registration successful. You can now sign in.</div><% } if("unavailable".equals(request.getParameter("error"))){ %><div class="alert error" role="alert">The database is unavailable. Start MySQL and check DB_USER and DB_PASSWORD in the Tomcat launch configuration.</div><% } else if("credentials".equals(request.getParameter("error"))){ %><div class="alert error" role="alert">No active account matched that email and password. Check them or register as a student.</div><% } else if(request.getParameter("error")!=null){ %><div class="alert error" role="alert">Sign in could not be completed. Please check your account and database configuration.</div><% } %><form method="post" action="login" autocomplete="on"><label>Email address<input type="email" name="email" autocomplete="username" required maxlength="254"></label><label>Password<input type="password" name="password" autocomplete="current-password" required maxlength="255"></label><button class="button primary full" type="submit">Sign in</button></form><p class="small muted">New student? <a href="register.jsp">Create an account</a></p><p class="small muted">Use your campus account. Contact your administrator if you need access.</p></main></body></html>
