<%@ page contentType="text/html;charset=UTF-8" %>
<%@ page import="com.grievancecampus.model.User,java.util.Map" %>
<% User u=(User)session.getAttribute("user"); Map c=(Map)request.getAttribute("counts"); String name=u==null?"HOD":u.getName(); String department=u==null?"":u.getDepartment(); String initial=name.isEmpty()?"H":name.substring(0,1).toUpperCase(); %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>HOD dashboard · Grievance Campus</title><link rel="stylesheet" href="../assets/css/style.css"><link rel="stylesheet" href="../assets/css/dashboard.css"></head>
<body><div class="app-shell"><aside class="sidebar"><a class="brand" href="../app/dashboard"><span class="brand-mark">G</span><span>Grievance Campus<small>Department workspace</small></span></a><p class="sidebar-label">Workspace</p><nav class="side-nav"><a class="active" href="../app/dashboard"><span class="nav-icon">⌂</span>Dashboard</a><a href="../app/grievances"><span class="nav-icon">▤</span>Department queue</a></nav><div class="sidebar-bottom"><div class="sidebar-user"><%=com.grievancecampus.util.HtmlUtil.escape(name)%></div><div class="sidebar-role">Head of department · <%=com.grievancecampus.util.HtmlUtil.escape(department)%></div></div></aside>
<main class="main-area"><header class="dashboard-topbar"><div class="breadcrumb">Department portal <span aria-hidden="true">/</span> Overview</div><div class="topbar-account"><span class="avatar"><%=com.grievancecampus.util.HtmlUtil.escape(initial)%></span><span class="account-name"><%=com.grievancecampus.util.HtmlUtil.escape(name)%></span><a class="topbar-signout" href="../logout">Sign out</a></div></header><div class="dashboard-content">
<section class="dashboard-heading"><div><p class="eyebrow">DEPARTMENT MONITORING</p><h1>Department overview</h1><p>Track grievance activity across <%=com.grievancecampus.util.HtmlUtil.escape(department)%>.</p></div><a class="button primary" href="../app/grievances">Open department queue →</a></section>
<%if(Boolean.TRUE.equals(request.getAttribute("dashboardError"))){%><div class="alert error">We could not load the latest statistics.</div><%}%>
<section class="cards" aria-label="Department grievance statistics"><article class="stat"><div class="stat-top"><span>Total grievances</span><span class="stat-icon">▤</span></div><strong><%=c==null?"—":c.get("total")%></strong><span class="stat-foot">Across your department</span></article><article class="stat"><div class="stat-top"><span>Pending</span><span class="stat-icon">◷</span></div><strong><%=c==null?"—":c.get("pending")%></strong><span class="stat-foot">Awaiting review</span></article><article class="stat"><div class="stat-top"><span>Completed</span><span class="stat-icon">✓</span></div><strong><%=c==null?"—":c.get("resolved")%></strong><span class="stat-foot">Completed concerns</span></article></section>
<section class="dashboard-panel"><div class="panel-heading"><div><h2>Department review</h2><p>Monitor the queue and follow up on concerns. Admin handles grievance assignments.</p></div></div><a class="button primary" href="../app/grievances">View department grievances</a></section>
<jsp:include page="/staff/worker-tasks.jsp" />
</div></main></div></body></html>
