<%@ page contentType="text/html;charset=UTF-8" %>
<%@ page import="com.grievancecampus.model.User,java.util.*" %>
<% User u=(User)session.getAttribute("user"); Map c=(Map)request.getAttribute("counts"); List<Map<String,Object>> recent=(List<Map<String,Object>>)request.getAttribute("recentGrievances"); String name=u==null?"Admin":u.getName(); String initial=name.isEmpty()?"A":name.substring(0,1).toUpperCase(); %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Admin dashboard · Grievance Campus</title><link rel="stylesheet" href="../assets/css/style.css"><link rel="stylesheet" href="../assets/css/dashboard.css"></head>
<body><div class="app-shell"><aside class="sidebar"><a class="brand" href="../app/dashboard"><span class="brand-mark">G</span><span>Grievance Campus<small>Administration</small></span></a><p class="sidebar-label">Workspace</p><nav class="side-nav"><a class="active" href="../app/dashboard"><span class="nav-icon">⌂</span>Dashboard</a><a href="../app/users"><span class="nav-icon">♙</span>Manage users</a><a href="../app/grievances"><span class="nav-icon">▤</span>Grievances</a></nav><div class="sidebar-bottom"><div class="sidebar-user"><%=com.grievancecampus.util.HtmlUtil.escape(name)%></div><div class="sidebar-role">Administrator</div></div></aside>
<main class="main-area"><header class="dashboard-topbar"><div class="breadcrumb">Administration <span aria-hidden="true">/</span> Overview</div><div class="topbar-account"><span class="avatar"><%=com.grievancecampus.util.HtmlUtil.escape(initial)%></span><span class="account-name"><%=com.grievancecampus.util.HtmlUtil.escape(name)%></span><a class="topbar-signout" href="../logout">Sign out</a></div></header><div class="dashboard-content">
<section class="dashboard-heading"><div><p class="eyebrow">CAMPUS OPERATIONS</p><h1>Administration overview</h1><p>Monitor accounts, grievance activity, and staff workload.</p></div><a class="button primary" href="../app/users">＋ Manage accounts</a></section>
<%if(Boolean.TRUE.equals(request.getAttribute("dashboardError"))){%><div class="alert error">Statistics could not be loaded. Please refresh or try again later.</div><%}%>
<%if("1".equals(request.getParameter("updated"))||"1".equals(request.getParameter("deleted"))){%><div class="notice" role="status">Dashboard updated successfully.</div><%}if(request.getParameter("error")!=null){%><div class="alert error" role="alert">The requested action could not be completed.</div><%}%>
<section class="cards" aria-label="Campus statistics"><article class="stat"><div class="stat-top"><span>Students</span><span class="stat-icon">♙</span></div><strong><%=c==null?"—":c.get("students")%></strong><span class="stat-foot">Registered student accounts</span></article><article class="stat"><div class="stat-top"><span>Staff</span><span class="stat-icon">♧</span></div><strong><%=c==null?"—":c.get("staff")%></strong><span class="stat-foot">Available for assignment</span></article><article class="stat"><div class="stat-top"><span>All grievances</span><span class="stat-icon">▤</span></div><strong><%=c==null?"—":c.get("total")%></strong><span class="stat-foot">Across campus</span></article><article class="stat"><div class="stat-top"><span>Pending</span><span class="stat-icon">◷</span></div><strong><%=c==null?"—":c.get("pending")%></strong><span class="stat-foot">Waiting for worker action</span></article><article class="stat"><div class="stat-top"><span>Unassigned</span><span class="stat-icon">!</span></div><strong><%=c==null?"—":c.get("unassigned")%></strong><span class="stat-foot">Need assignment or review</span></article><article class="stat"><div class="stat-top"><span>Completed grievances</span><span class="stat-icon">✓</span></div><strong><%=c==null?"—":c.get("resolved")%></strong><span class="stat-foot">Completed by staff</span></article><article class="stat"><div class="stat-top"><span>Completed tasks</span><span class="stat-icon">✓</span></div><strong><%=c==null?"—":c.get("completed")%></strong><span class="stat-foot">Staff assignments completed</span></article></section>
<section class="quick-links" aria-label="Administration shortcuts"><a class="quick-link" href="../app/users"><span class="stat-icon">♙</span><span><strong>User management</strong><small>Create and review campus accounts</small></span></a><a class="quick-link" href="../app/grievances"><span class="stat-icon">▤</span><span><strong>Grievance queue</strong><small>Review, assign, or reject concerns</small></span></a></section>
<section class="dashboard-panel"><div class="panel-heading"><div><h2>All grievances</h2><p>Every student submission with student details, location, photo, submission date, and live status.</p></div><a class="panel-link" href="../app/grievances">Open full queue →</a></div>
<%if(recent==null||recent.isEmpty()){%><div class="empty"><strong>No grievances submitted</strong>New student submissions will appear here.</div><%}else{%><div class="task-list"><%for(Map<String,Object> g:recent){%><article class="task-card"><div class="task-meta">#<%=g.get("grievance_id")%> · Submitted <%=com.grievancecampus.util.HtmlUtil.escape(g.get("created_at"))%> · <span class="badge"><%="RESOLVED".equals(String.valueOf(g.get("status")))?"COMPLETED":com.grievancecampus.util.HtmlUtil.escape(g.get("status"))%></span></div><h3><%=com.grievancecampus.util.HtmlUtil.escape(g.get("title"))%></h3><p><%=com.grievancecampus.util.HtmlUtil.escape(g.get("category"))%> · <%=com.grievancecampus.util.HtmlUtil.escape(g.get("description"))%></p><p><strong>Student:</strong> <%=com.grievancecampus.util.HtmlUtil.escape(g.get("student_name"))%> · <%=com.grievancecampus.util.HtmlUtil.escape(g.get("student_email"))%></p><p><strong>Location:</strong> <%=g.get("location_text")==null?"Not provided":com.grievancecampus.util.HtmlUtil.escape(g.get("location_text"))%><%if(g.get("latitude")!=null){%> (<%=com.grievancecampus.util.HtmlUtil.escape(g.get("latitude"))%>, <%=com.grievancecampus.util.HtmlUtil.escape(g.get("longitude"))%>)<%}%></p><%if(g.get("photo_path")!=null){%><a href="../app/photo?id=<%=g.get("grievance_id")%>" target="_blank" rel="noopener"><img class="grievance-thumb" src="../app/photo?id=<%=g.get("grievance_id")%>" alt="Submitted grievance photo">View submitted photo</a><%}%><p class="small"><strong>Assignments:</strong> <%=com.grievancecampus.util.HtmlUtil.escape(g.get("assignment_summary"))%></p><form method="post" action="../app/grievances" onsubmit="return confirm('Remove this grievance from active dashboards?')"><input type="hidden" name="action" value="delete"><input type="hidden" name="grievanceId" value="<%=g.get("grievance_id")%>"><button class="button" type="submit">Delete grievance</button></form></article><%}%></div><%}%></section>
</div></main></div></body></html>
