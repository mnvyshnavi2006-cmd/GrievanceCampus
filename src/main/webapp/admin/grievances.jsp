<%@ page contentType="text/html;charset=UTF-8" %>
<%@ page import="java.util.*,com.grievancecampus.model.User" %>
<% List<Map<String,Object>> rows=(List<Map<String,Object>>)request.getAttribute("queue"); List<User> workers=(List<User>)request.getAttribute("staffUsers"); List<User> coordinators=(List<User>)request.getAttribute("coordinatorUsers"); User me=(User)session.getAttribute("user"); String role=me==null?"":me.getRole(); boolean admin="ADMIN".equals(role); String title=admin?"Campus grievance queue":"Department grievance queue"; String scope=admin?"All departments":String.valueOf(me.getDepartment())+("TEACHER".equals(role)||"CLASS_TEACHER".equals(role)?" · Section "+me.getSection():""); String name=me==null?"":me.getName(); %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%=title%> · Grievance Campus</title><link rel="stylesheet" href="../assets/css/style.css"><link rel="stylesheet" href="../assets/css/dashboard.css"></head>
<body><div class="app-shell"><aside class="sidebar"><a class="brand" href="../app/dashboard"><span class="brand-mark">G</span><span>Grievance Campus<small>Review workspace</small></span></a><p class="sidebar-label">Workspace</p><nav class="side-nav"><a href="../app/dashboard"><span class="nav-icon">⌂</span>Dashboard</a><a class="active" href="../app/grievances"><span class="nav-icon">▤</span>Grievance queue</a><%if("ADMIN".equals(role)){%><a href="../app/users"><span class="nav-icon">♙</span>Manage users</a><%}%></nav></aside>
<main class="main-area"><header class="dashboard-topbar"><div class="breadcrumb">Review workspace <span aria-hidden="true">/</span> Grievances</div><div class="topbar-account"><span class="account-name"><%=com.grievancecampus.util.HtmlUtil.escape(name)%></span><a class="topbar-signout" href="../logout">Sign out</a></div></header><div class="dashboard-content">
<section class="dashboard-heading"><div><p class="eyebrow">GRIEVANCE REVIEW</p><h1><%=title%></h1><p><%=com.grievancecampus.util.HtmlUtil.escape(scope)%> · Assign eligible workers or remove requests from active dashboards.</p></div></section>
<%if("1".equals(request.getParameter("updated"))||"1".equals(request.getParameter("deleted"))){%><div class="notice" role="status">Queue updated successfully.</div><%}if(request.getParameter("error")!=null){%><div class="alert error" role="alert">The requested action could not be completed. Check your access and try again.</div><%}%><section class="dashboard-panel queue-panel"><div class="panel-heading"><div><h2>Requests</h2><p><%=admin?"Choose any active worker directly or route through a Teacher/HOD.":"Review submissions in your scope. Only Admin can assign or reject grievances."%></p></div><span class="badge"><%=rows==null?0:rows.size()%> shown</span></div>
<%if(rows==null||rows.isEmpty()){%><div class="empty"><strong>Queue is clear</strong>No grievances are available in this scope.</div><%}else{%><div class="table-wrap"><table><thead><tr><th>Grievance and student</th><th>Location</th><th>Submitted</th><th>Status</th><th>Assigned workers</th><%if(admin){%><th>Assign worker</th><%}%></tr></thead><tbody>
<%for(Map<String,Object> g:rows){String department=String.valueOf(g.get("department"));String assigned=String.valueOf(g.get("assignment_summary"));boolean eligibleWorker=false;%>
<tr><td><strong>#<%=g.get("grievance_id")%> · <%=com.grievancecampus.util.HtmlUtil.escape(g.get("title"))%></strong><br><span class="small"><%=com.grievancecampus.util.HtmlUtil.escape(g.get("category"))%> · <%=com.grievancecampus.util.HtmlUtil.escape(g.get("description"))%></span><br><strong><%=com.grievancecampus.util.HtmlUtil.escape(g.get("student_name"))%></strong><br><span class="small"><%=com.grievancecampus.util.HtmlUtil.escape(g.get("student_email"))%> · <%=com.grievancecampus.util.HtmlUtil.escape(department)%> · <%=com.grievancecampus.util.HtmlUtil.escape(g.get("section"))%></span><%if(admin&&g.get("photo_path")!=null){%><br><a href="../app/photo?id=<%=g.get("grievance_id")%>" target="_blank" rel="noopener"><img class="grievance-thumb" src="../app/photo?id=<%=g.get("grievance_id")%>" alt="Submitted grievance photo">View photo</a><%}%></td><td><%=g.get("location_text")==null?"Not provided":com.grievancecampus.util.HtmlUtil.escape(g.get("location_text"))%><%if(g.get("latitude")!=null){%><br><span class="small"><%=com.grievancecampus.util.HtmlUtil.escape(g.get("latitude"))%>, <%=com.grievancecampus.util.HtmlUtil.escape(g.get("longitude"))%></span><%}%></td><td><%=com.grievancecampus.util.HtmlUtil.escape(g.get("created_at"))%></td><td><span class="badge"><%="RESOLVED".equals(String.valueOf(g.get("status")))?"COMPLETED":com.grievancecampus.util.HtmlUtil.escape(g.get("status"))%></span></td><td><%=com.grievancecampus.util.HtmlUtil.escape(assigned)%></td><%if(admin){%><td>
<form method="post" action="../app/assignments" class="assign-form <%=admin?"routed-assign-form":""%>"><input type="hidden" name="action" value="assign"><input type="hidden" name="grievanceId" value="<%=g.get("grievance_id")%>">
<%if(admin){%><label class="assign-field">Route<select data-route-role aria-label="Assignment route"><option value="DIRECT">Direct to staff</option><option value="TEACHER">Through Teacher</option><option value="HOD">Through HOD</option></select></label><label class="assign-field coordinator-field" hidden>Teacher or HOD<select name="coordinatorId" data-coordinator disabled><option value="">Choose coordinator</option><%if(coordinators!=null)for(User coordinator:coordinators){boolean sameDepartment=coordinator.getDepartment()!=null&&coordinator.getDepartment().equals(department);boolean sameSection="HOD".equals(coordinator.getRole())||Objects.equals(coordinator.getSection(),String.valueOf(g.get("section")));if(sameDepartment&&sameSection){%><option value="<%=coordinator.getId()%>" data-role="<%="HOD".equals(coordinator.getRole())?"HOD":"TEACHER"%>"><%=com.grievancecampus.util.HtmlUtil.escape(coordinator.getName())%> · <%="HOD".equals(coordinator.getRole())?"HOD":"Teacher"%></option><%}}%></select></label><%}%>
<label class="assign-field">Worker<select name="assigneeId" required aria-label="Choose a worker"><option value="">Choose worker</option><%if(workers!=null)for(User worker:workers){if(admin||worker.getDepartment()!=null&&worker.getDepartment().equals(department)){eligibleWorker=true;String workerTitle=worker.getJobTitle()==null||worker.getJobTitle().isEmpty()?worker.getRole():worker.getJobTitle();%><option value="<%=worker.getId()%>"><%=com.grievancecampus.util.HtmlUtil.escape(worker.getName())%> · <%=com.grievancecampus.util.HtmlUtil.escape(workerTitle)%> · <%=com.grievancecampus.util.HtmlUtil.escape(worker.getDepartment())%></option><%}}%></select></label><button class="button primary" type="submit" <%=eligibleWorker&&!"RESOLVED".equals(String.valueOf(g.get("status")))?"":"disabled"%>>Assign</button></form>
<%if(!eligibleWorker){%><span class="small">No active worker account exists. Create one in Manage users first.</span><%}else if("RESOLVED".equals(String.valueOf(g.get("status")))){%><span class="small">Completed grievances cannot be reassigned.</span><%}%><%if("Not assigned".equals(assigned)&&"PENDING".equals(g.get("status"))){%><form method="post" action="../app/assignments" class="reject-form"><input type="hidden" name="action" value="reject"><input type="hidden" name="grievanceId" value="<%=g.get("grievance_id")%>"><button class="button" type="submit">Reject</button></form><%}%>
<%if(admin){%><form method="post" action="../app/grievances" onsubmit="return confirm('Remove this grievance from active dashboards?')"><input type="hidden" name="action" value="delete"><input type="hidden" name="grievanceId" value="<%=g.get("grievance_id")%>"><button class="button" type="submit">Delete</button></form><%}%></td><%}%></tr><%}%></tbody></table></div><%}%></section>
</div></main></div><script defer src="../assets/js/assignment.js"></script></body></html>
