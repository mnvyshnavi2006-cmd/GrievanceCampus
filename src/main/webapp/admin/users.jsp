<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*,com.grievancecampus.model.User" %><%List<User> users=(List<User>)request.getAttribute("users");%><!doctype html><html><head><meta charset="utf-8"><title>User management</title><link rel="stylesheet" href="../assets/css/style.css"><script defer src="../assets/js/dashboard.js"></script></head><body><main class="page"><a href="../app/dashboard">← Admin</a><h1>User management</h1><%if(request.getParameter("saved")!=null){%><div class="notice">Account created.</div><%}if(request.getParameter("error")!=null){%><div class="alert error">The account could not be created. Check the required fields and ensure the email is unique.</div><%}%><section class="panel"><h2>Create account</h2><p>Students register themselves. Create worker and campus management accounts here.</p><form method="post" action="../app/users"><label>Name<input name="name" maxlength="120" required></label><label>Email<input type="email" name="email" maxlength="254" required></label><label>Password (8–255 characters)<input type="password" name="password" minlength="8" maxlength="255" required></label><label>Role<select name="role"><option value="STAFF">Staff worker</option><option value="CLASS_TEACHER">Class Teacher</option><option value="TEACHER">Teacher</option><option value="HOD">HOD</option><option value="ADMIN">Admin</option></select></label><label>Worker designation<select name="jobTitle"><option value="">Not applicable</option><option>Cleaning Staff</option><option>College Accountant</option><option>Technician</option><option>Other Staff</option><option>Class Teacher</option><option>HOD</option><option>Teacher</option></select></label><label>Department<input name="department" maxlength="120"></label><label>Section<input name="section" maxlength="50"></label><button class="button primary">Create account</button></form></section><section class="panel"><h2>Accounts</h2><input type="search" placeholder="Search accounts" data-filter="tbody tr"><div class="table-wrap"><table><thead><tr><th>ID</th><th>Name</th><th>Email</th><th>Role</th><th>Designation</th><th>Department</th><th>Section</th></tr></thead><tbody><%if(users!=null)for(User user:users){%><tr><td><%=user.getId()%></td><td><%=com.grievancecampus.util.HtmlUtil.escape(user.getName())%></td><td><%=com.grievancecampus.util.HtmlUtil.escape(user.getEmail())%></td><td><%=com.grievancecampus.util.HtmlUtil.escape(user.getRole())%></td><td><%=com.grievancecampus.util.HtmlUtil.escape(user.getJobTitle())%></td><td><%=com.grievancecampus.util.HtmlUtil.escape(user.getDepartment())%></td><td><%=com.grievancecampus.util.HtmlUtil.escape(user.getSection())%></td></tr><%}%></tbody></table></div></section></main></body></html>
