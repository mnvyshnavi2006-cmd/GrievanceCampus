<%@ page contentType="text/html;charset=UTF-8" %>
<%@ page import="com.grievancecampus.model.User,java.util.*" %>
<% User u=(User)session.getAttribute("user"); Map c=(Map)request.getAttribute("counts"); List<Map<String,Object>> tasks=(List<Map<String,Object>>)request.getAttribute("tasks"); String name=u==null?"Staff":u.getName(); String initial=name.isEmpty()?"S":name.substring(0,1).toUpperCase(); %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Staff dashboard · Grievance Campus</title><link rel="stylesheet" href="../assets/css/style.css"><link rel="stylesheet" href="../assets/css/dashboard.css"></head>
<body><div class="app-shell"><aside class="sidebar"><a class="brand" href="../app/dashboard"><span class="brand-mark">G</span><span>Grievance Campus<small>Staff workspace</small></span></a><p class="sidebar-label">Workspace</p><nav class="side-nav"><a class="active" href="../app/dashboard"><span class="nav-icon">⌂</span>Dashboard</a><a href="#tasks"><span class="nav-icon">✓</span>My tasks</a></nav><div class="sidebar-bottom"><div class="sidebar-user"><%=com.grievancecampus.util.HtmlUtil.escape(name)%></div><div class="sidebar-role">Campus staff</div></div></aside>
<main class="main-area"><header class="dashboard-topbar"><div class="breadcrumb">Staff portal <span aria-hidden="true">/</span> My tasks</div><div class="topbar-account"><span class="avatar"><%=com.grievancecampus.util.HtmlUtil.escape(initial)%></span><span class="account-name"><%=com.grievancecampus.util.HtmlUtil.escape(name)%></span><a class="topbar-signout" href="../logout">Sign out</a></div></header><div class="dashboard-content">
<section class="dashboard-heading"><div><p class="eyebrow">STAFF WORKSPACE</p><h1>Your assigned tasks</h1><p>Update progress and leave clear notes for each assigned grievance.</p></div></section>
<%if(Boolean.TRUE.equals(request.getAttribute("dashboardError"))){%><div class="alert error">We could not load your tasks. Please refresh or try again later.</div><%}%>
<%if("1".equals(request.getParameter("updated"))){%><div class="notice" role="status">Task status and progress were saved.</div><%}if(request.getParameter("error")!=null){%><div class="alert error" role="alert">The task update could not be saved. Check the status and note, then retry.</div><%}%>
<section class="cards" aria-label="Task statistics"><article class="stat"><div class="stat-top"><span>Total tasks</span><span class="stat-icon">▤</span></div><strong><%=c==null?"—":c.get("total")%></strong><span class="stat-foot">Assigned to your account</span></article><article class="stat"><div class="stat-top"><span>Pending</span><span class="stat-icon">◷</span></div><strong><%=c==null?"—":c.get("pending")%></strong><span class="stat-foot">Awaiting completion</span></article><article class="stat"><div class="stat-top"><span>Completed</span><span class="stat-icon">✓</span></div><strong><%=c==null?"—":c.get("completed")%></strong><span class="stat-foot">Marked complete</span></article></section>
<section class="dashboard-panel" id="tasks"><div class="panel-heading"><div><h2>Assigned to me</h2><p>Record progress or completion notes on each task.</p></div></div>
<%if(tasks==null||tasks.isEmpty()){%><div class="empty"><strong>You’re all caught up</strong>No grievances have been assigned to you yet.</div><%}else{%><div class="task-list"><%for(Map<String,Object> task:tasks){%><article class="task-card"><div class="task-meta">Grievance #<%=task.get("grievance_id")%> · <%=com.grievancecampus.util.HtmlUtil.escape(task.get("department"))%><%if(task.get("section")!=null){%> · Section <%=com.grievancecampus.util.HtmlUtil.escape(task.get("section"))%><%}%></div><h3><a href="../app/assignments?taskId=<%=task.get("assignment_id")%>"><%=com.grievancecampus.util.HtmlUtil.escape(task.get("title"))%></a></h3><p><a href="../app/assignments?taskId=<%=task.get("assignment_id")%>">Open complete grievance details →</a></p><p><%=com.grievancecampus.util.HtmlUtil.escape(task.get("description"))%></p><p>Task status: <span class="badge"><%=com.grievancecampus.util.HtmlUtil.escape(task.get("task_status"))%></span> · grievance status: <span class="badge"><%="RESOLVED".equals(String.valueOf(task.get("grievance_status")))?"COMPLETED":com.grievancecampus.util.HtmlUtil.escape(task.get("grievance_status"))%></span></p><p class="small">Assigned by <%=com.grievancecampus.util.HtmlUtil.escape(task.get("assigned_by_name"))%><%if(task.get("coordinator_name")!=null){%> · Coordinated by <%=com.grievancecampus.util.HtmlUtil.escape(task.get("coordinator_name"))%><%}%></p><%if("COMPLETED".equals(String.valueOf(task.get("task_status")))){%><p><strong>Completion note:</strong> <%=com.grievancecampus.util.HtmlUtil.escape(task.get("completion_notes"))%></p><%}else{%><form method="post" action="../app/assignments"><input type="hidden" name="action" value="update"><input type="hidden" name="assignmentId" value="<%=task.get("assignment_id")%>"><label>Progress / completion note<textarea name="note" maxlength="3000" required placeholder="Describe the work or why it remains pending"></textarea></label><label>Update status<select name="status"><option value="PENDING" <%="PENDING".equals(String.valueOf(task.get("task_status")))?"selected":""%>>Pending</option><option value="COMPLETED">Completed</option></select></label><button class="button primary" type="submit">Save task update</button></form><%}%></article><%}%></div><%}%></section>
</div></main></div></body></html>
