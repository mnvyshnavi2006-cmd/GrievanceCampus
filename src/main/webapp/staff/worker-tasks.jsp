<%@ page contentType="text/html;charset=UTF-8" %>
<%@ page import="java.util.*" %>
<% List<Map<String,Object>> assignedTasks=(List<Map<String,Object>>)request.getAttribute("tasks"); %>
<section class="dashboard-panel" id="assigned-tasks"><div class="panel-heading"><div><h2>Tasks assigned to me</h2><p>Open a grievance to view its location, evidence, and progress history.</p></div></div>
<%if(assignedTasks==null||assignedTasks.isEmpty()){%><div class="empty"><strong>No assigned tasks</strong>Tasks assigned to your account will appear here.</div><%}else{%><div class="task-list"><%for(Map<String,Object> task:assignedTasks){%><article class="task-card"><div class="task-meta">Grievance #<%=task.get("grievance_id")%> · <%=com.grievancecampus.util.HtmlUtil.escape(task.get("department"))%> · <span class="badge"><%=com.grievancecampus.util.HtmlUtil.escape(task.get("task_status"))%></span></div><h3><%=com.grievancecampus.util.HtmlUtil.escape(task.get("title"))%></h3><p><%=com.grievancecampus.util.HtmlUtil.escape(task.get("description"))%></p><p class="small">Assigned by <%=com.grievancecampus.util.HtmlUtil.escape(task.get("assigned_by_name"))%><%if(task.get("coordinator_name")!=null){%> · Coordinated by <%=com.grievancecampus.util.HtmlUtil.escape(task.get("coordinator_name"))%><%}%></p><a class="button primary" href="../app/assignments?taskId=<%=task.get("assignment_id")%>">Open details and update task</a></article><%}%></div><%}%></section>
