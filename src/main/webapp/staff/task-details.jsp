<%@ page contentType="text/html;charset=UTF-8" %>
<%@ page import="java.util.*" %>
<% Map<String,Object> task=(Map<String,Object>)request.getAttribute("task");if(task==null){response.sendRedirect(request.getContextPath()+"/app/dashboard");return;}List<Map<String,Object>> history=(List<Map<String,Object>>)task.get("updates");%>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Grievance #<%=com.grievancecampus.util.HtmlUtil.escape(task.get("grievance_id"))%> · Task details</title><link rel="stylesheet" href="../assets/css/style.css"><link rel="stylesheet" href="../assets/css/dashboard.css"></head><body><main class="page narrow"><a href="../app/dashboard">← My dashboard</a><p class="eyebrow">ASSIGNED TASK #<%=com.grievancecampus.util.HtmlUtil.escape(task.get("assignment_id"))%></p><h1><%=com.grievancecampus.util.HtmlUtil.escape(task.get("title"))%></h1><p><span class="badge"><%=com.grievancecampus.util.HtmlUtil.escape(task.get("task_status"))%></span> Task · <span class="badge"><%="RESOLVED".equals(String.valueOf(task.get("grievance_status")))?"COMPLETED":com.grievancecampus.util.HtmlUtil.escape(task.get("grievance_status"))%></span> Grievance</p><section class="panel"><h2>Complete grievance details</h2><p><strong>Category:</strong> <%=com.grievancecampus.util.HtmlUtil.escape(task.get("category"))%></p><p><strong>Submitted:</strong> <%=com.grievancecampus.util.HtmlUtil.escape(task.get("submitted_at"))%></p><p><strong>Department / section:</strong> <%=com.grievancecampus.util.HtmlUtil.escape(task.get("department"))%> · <%=com.grievancecampus.util.HtmlUtil.escape(task.get("section"))%></p><p><strong>Description:</strong><br><%=com.grievancecampus.util.HtmlUtil.escape(task.get("description"))%></p><p><strong>Location:</strong> <%=task.get("location_text")==null?"Not provided":com.grievancecampus.util.HtmlUtil.escape(task.get("location_text"))%><%if(task.get("latitude")!=null){%> (<%=com.grievancecampus.util.HtmlUtil.escape(task.get("latitude"))%>, <%=com.grievancecampus.util.HtmlUtil.escape(task.get("longitude"))%>)<%}%></p><%if(task.get("photo_path")!=null){%><p><a href="../app/photo?id=<%=task.get("grievance_id")%>" target="_blank" rel="noopener">Open grievance photo</a></p><img src="../app/photo?id=<%=task.get("grievance_id")%>" alt="Grievance evidence photo" style="max-width:100%;border-radius:12px"><%}%><p class="small">Assigned by <%=com.grievancecampus.util.HtmlUtil.escape(task.get("assigned_by_name"))%><%if(task.get("coordinator_name")!=null){%> · Coordinated by <%=com.grievancecampus.util.HtmlUtil.escape(task.get("coordinator_name"))%><%}%></p></section>
<%if(!"COMPLETED".equals(String.valueOf(task.get("task_status")))){%><section class="panel"><h2>Update task</h2><form method="post" action="../app/assignments"><input type="hidden" name="action" value="update"><input type="hidden" name="assignmentId" value="<%=task.get("assignment_id")%>"><label>Progress note / completion remarks<textarea name="note" maxlength="3000" required></textarea></label><label>Status<select name="status"><option value="PENDING" <%="PENDING".equals(String.valueOf(task.get("task_status")))?"selected":""%>>Pending</option><option value="COMPLETED">Completed</option></select></label><button class="button primary" type="submit">Save update</button></form></section><%}else{%><section class="panel"><h2>Completion remarks</h2><p><%=com.grievancecampus.util.HtmlUtil.escape(task.get("completion_notes"))%></p><p>Completed: <%=com.grievancecampus.util.HtmlUtil.escape(task.get("task_completed_at"))%></p></section><%}%>
<section class="panel"><h2>Assignment and progress history</h2><%if(history==null||history.isEmpty()){%><p>No task history recorded.</p><%}else{%><ul><%for(Map<String,Object> event:history){%><li><strong><%=com.grievancecampus.util.HtmlUtil.escape(event.get("status"))%></strong> · <%=com.grievancecampus.util.HtmlUtil.escape(event.get("created_at"))%> · <%=com.grievancecampus.util.HtmlUtil.escape(event.get("author_name"))%><p><%=com.grievancecampus.util.HtmlUtil.escape(event.get("note"))%></p></li><%}%></ul><%}%></section></main></body></html>
