<%@ page contentType="text/html;charset=UTF-8" %>
<%@ page import="com.grievancecampus.model.User,java.util.Map" %>
<% User u=(User)session.getAttribute("user"); Map c=(Map)request.getAttribute("counts"); String name=u==null?"Teacher":u.getName(); String scope=(u==null?"":u.getDepartment())+(u!=null&&u.getSection()!=null?" · Section "+u.getSection():""); String initial=name.isEmpty()?"T":name.substring(0,1).toUpperCase(); %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Teacher dashboard · Grievance Campus</title><link rel="stylesheet" href="../assets/css/style.css"><link rel="stylesheet" href="../assets/css/dashboard.css"></head>
<body><div class="app-shell"><aside class="sidebar"><a class="brand" href="../app/dashboard"><span class="brand-mark">G</span><span>Grievance Campus<small>Teacher workspace</small></span></a><p class="sidebar-label">Workspace</p><nav class="side-nav"><a class="active" href="../app/dashboard"><span class="nav-icon">⌂</span>Dashboard</a><a href="../app/grievances"><span class="nav-icon">▤</span>Grievance queue</a></nav><div class="sidebar-bottom"><div class="sidebar-user"><%=com.grievancecampus.util.HtmlUtil.escape(name)%></div><div class="sidebar-role">Class teacher · <%=com.grievancecampus.util.HtmlUtil.escape(scope)%></div></div></aside>
<main class="main-area"><header class="dashboard-topbar"><div class="breadcrumb">Teacher portal <span aria-hidden="true">/</span> Overview</div><div class="topbar-account"><span class="avatar"><%=com.grievancecampus.util.HtmlUtil.escape(initial)%></span><span class="account-name"><%=com.grievancecampus.util.HtmlUtil.escape(name)%></span><a class="topbar-signout" href="../logout">Sign out</a></div></header><div class="dashboard-content">
<section class="dashboard-heading"><div><p class="eyebrow">CLASS TEACHER</p><h1>Class overview</h1><p>Review concerns from <%=com.grievancecampus.util.HtmlUtil.escape(scope)%>.</p></div><a class="button primary" href="../app/grievances">Open grievance queue →</a></section>
<%if(Boolean.TRUE.equals(request.getAttribute("dashboardError"))){%><div class="alert error">We could not load the latest statistics.</div><%}%>
<section class="cards" aria-label="Department grievance statistics"><article class="stat"><div class="stat-top"><span>Grievances in scope</span><span class="stat-icon">▤</span></div><strong><%=c==null?"—":c.get("total")%></strong><span class="stat-foot">Your class section</span></article><article class="stat"><div class="stat-top"><span>Pending review</span><span class="stat-icon">◷</span></div><strong><%=c==null?"—":c.get("pending")%></strong><span class="stat-foot">Need attention</span></article><article class="stat"><div class="stat-top"><span>Completed</span><span class="stat-icon">✓</span></div><strong><%=c==null?"—":c.get("resolved")%></strong><span class="stat-foot">Marked complete</span></article></section>
<section class="dashboard-panel"><div class="panel-heading"><div><h2>Next step</h2><p>Review new concerns and contact Admin when an assignment is needed.</p></div></div><a class="button primary" href="../app/grievances">Review section grievances</a></section>
<jsp:include page="/staff/worker-tasks.jsp" />
</div></main></div></body></html>
