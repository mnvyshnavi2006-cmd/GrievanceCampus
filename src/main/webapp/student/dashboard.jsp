<%@ page contentType="text/html;charset=UTF-8" %>
<%@ page import="com.grievancecampus.model.User,com.grievancecampus.model.Grievance,java.util.*" %>
<% User u=(User)session.getAttribute("user"); Map counts=(Map)request.getAttribute("counts"); List<Grievance> rows=(List<Grievance>)request.getAttribute("grievances"); String name=u==null?"Student":u.getName(); String initial=name.isEmpty()?"S":name.substring(0,1).toUpperCase(); %>
<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Student dashboard · Grievance Campus</title><link rel="stylesheet" href="../assets/css/style.css"><link rel="stylesheet" href="../assets/css/dashboard.css"></head>
<body><div class="app-shell">
<aside class="sidebar"><a class="brand" href="../app/dashboard"><span class="brand-mark">G</span><span>Grievance Campus<small>Student support</small></span></a><p class="sidebar-label">Workspace</p><nav class="side-nav"><a class="active" href="../app/dashboard"><span class="nav-icon">⌂</span>Dashboard</a><a href="<%=request.getContextPath()%>/student/submit-grievance.jsp"><span class="nav-icon">＋</span>Submit grievance</a><a href="#recent"><span class="nav-icon">▤</span>My grievances</a></nav><div class="sidebar-bottom"><div class="sidebar-user"><%=com.grievancecampus.util.HtmlUtil.escape(name)%></div><div class="sidebar-role">Student account</div></div></aside>
<main class="main-area"><header class="dashboard-topbar"><div class="breadcrumb">Student portal <span aria-hidden="true">/</span> Overview</div><div class="topbar-account"><span class="avatar"><%=com.grievancecampus.util.HtmlUtil.escape(initial)%></span><span class="account-name"><%=com.grievancecampus.util.HtmlUtil.escape(name)%></span><a class="topbar-signout" href="../logout">Sign out</a></div></header>
<div class="dashboard-content"><section class="dashboard-heading"><div><p class="eyebrow">STUDENT PORTAL</p><h1>Welcome, <%=com.grievancecampus.util.HtmlUtil.escape(name)%></h1><p>Follow your concerns from submission through resolution.</p></div><a class="button primary" href="<%=request.getContextPath()%>/student/submit-grievance.jsp">＋ Submit a grievance</a></section>
<%if(Boolean.TRUE.equals(request.getAttribute("dashboardError"))){%><div class="alert error">We could not load your dashboard data. Please refresh or try again later.</div><%}%><%if(request.getParameter("saved")!=null){%><div class="notice">Your grievance was submitted successfully.</div><%}if("1".equals(request.getParameter("deleted"))){%><div class="notice">Grievance removed from your dashboard.</div><%}if(request.getParameter("error")!=null){%><div class="alert error">The requested action could not be completed. Please try again.</div><%}%>
<section class="cards" aria-label="Grievance statistics"><article class="stat"><div class="stat-top"><span>Total grievances</span><span class="stat-icon">▤</span></div><strong><%=counts==null?"—":counts.get("total")%></strong><span class="stat-foot">Submitted by you</span></article><article class="stat"><div class="stat-top"><span>Pending</span><span class="stat-icon">◷</span></div><strong><%=counts==null?"—":counts.get("pending")%></strong><span class="stat-foot">Awaiting review or work</span></article><article class="stat"><div class="stat-top"><span>Completed</span><span class="stat-icon">✓</span></div><strong><%=counts==null?"—":counts.get("resolved")%></strong><span class="stat-foot">Completed concerns</span></article></section>
<section class="dashboard-panel" id="recent"><div class="panel-heading"><div><h2>My grievances</h2><p>Recent submissions and their current status.</p></div><a class="panel-link" href="<%=request.getContextPath()%>/student/submit-grievance.jsp">＋ New grievance</a></div>
<%if(rows==null||rows.isEmpty()){%><div class="empty"><strong>No grievances yet</strong>Your submitted concerns will appear here.<br><a href="<%=request.getContextPath()%>/student/submit-grievance.jsp">Submit your first grievance</a></div><%}else{%><div class="table-wrap"><table><thead><tr><th>Reference</th><th>Grievance</th><th>Category</th><th>Submitted</th><th>Status</th><th>Action</th></tr></thead><tbody><%for(Grievance g:rows){%><tr><td>#<%=g.getId()%></td><td><a href="../app/grievance-details?id=<%=g.getId()%>"><%=com.grievancecampus.util.HtmlUtil.escape(g.getTitle())%></a></td><td><%=com.grievancecampus.util.HtmlUtil.escape(g.getCategory())%></td><td><%=g.getSubmittedAt()==null?"—":g.getSubmittedAt().toLocalDate()%></td><td><span class="badge"><%="RESOLVED".equals(g.getStatus())?"COMPLETED":com.grievancecampus.util.HtmlUtil.escape(g.getStatus())%></span></td><td><form method="post" action="../app/grievances" onsubmit="return confirm('Remove this grievance from your dashboard?')"><input type="hidden" name="action" value="delete"><input type="hidden" name="grievanceId" value="<%=g.getId()%>"><button class="button" type="submit">Delete</button></form></td></tr><%}%></tbody></table></div><%}%></section>
</div></main></div></body></html>
