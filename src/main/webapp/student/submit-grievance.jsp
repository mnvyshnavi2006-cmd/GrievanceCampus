<%@ page contentType="text/html;charset=UTF-8" %><!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Submit grievance</title><link rel="stylesheet" href="../assets/css/style.css"><script defer src="../assets/js/location.js"></script><script defer src="../assets/js/grievance.js"></script></head><body><main class="page narrow"><a href="../app/dashboard">← Dashboard</a><p class="eyebrow">STUDENT PORTAL</p><h1>Submit a grievance</h1><%if(request.getParameter("error")!=null){%><div class="alert error">Please check the required fields and try again.</div><%}%><%if(request.getParameter("saved")!=null){%><div class="notice">Your grievance was submitted.</div><%}%><form method="post" enctype="multipart/form-data" action="../app/grievances"><label>Title<input name="title" required maxlength="150"></label><label>Category<select name="category" required><option value="">Choose a category</option><option>Academic</option><option>Cleaning</option><option>Discipline</option><option>Fees</option><option>Lab</option><option>Sports</option><option>Infrastructure</option><option>Other</option></select></label><label>Description<textarea name="description" rows="6" maxlength="5000" required></textarea></label><label>Department<input name="department" maxlength="120" required></label><label>Section<input name="section" maxlength="50"></label><label>Optional photo<input type="file" name="photo" accept="image/jpeg,image/png,image/webp" data-preview="#photo-preview"></label><img id="photo-preview" alt="Photo preview" hidden style="max-width:100%;border-radius:12px"><button type="button" class="button" data-location="#location">Use my current location</button><input type="hidden" id="latitude" name="latitude"><input type="hidden" id="longitude" name="longitude"><label>Location description<input id="location" name="location" maxlength="300" required placeholder="Building, room, or campus area"></label><button class="button primary" type="submit">Submit grievance</button></form></main></body></html>
