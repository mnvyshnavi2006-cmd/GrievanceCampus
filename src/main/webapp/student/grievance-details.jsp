<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*" %><%if(request.getAttribute("grievance")==null){response.sendRedirect(request.getContextPath()+"/app/dashboard");return;}Map<String,Object> g=(Map<String,Object>)request.getAttribute("grievance");List<Map<String,Object>> updates=(List<Map<String,Object>>)g.get("updates");%><!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Grievance #<%=com.grievancecampus.util.HtmlUtil.escape(g.get("grievance_id"))%></title><link rel="stylesheet" href="../assets/css/style.css"></head><body><main class="page narrow"><a href="../app/dashboard">← Dashboard</a><p class="eyebrow">GRIEVANCE #<%=com.grievancecampus.util.HtmlUtil.escape(g.get("grievance_id"))%></p><h1><%=com.grievancecampus.util.HtmlUtil.escape(g.get("title"))%></h1><p><span class="badge"><%="RESOLVED".equals(String.valueOf(g.get("status")))?"COMPLETED":com.grievancecampus.util.HtmlUtil.escape(g.get("status"))%></span> · <%=com.grievancecampus.util.HtmlUtil.escape(g.get("category"))%> · <%=com.grievancecampus.util.HtmlUtil.escape(g.get("created_at"))%></p><section class="panel"><h2>Description</h2><p><%=com.grievancecampus.util.HtmlUtil.escape(g.get("description"))%></p><p><%=com.grievancecampus.util.HtmlUtil.escape(g.get("department"))%><%=g.get("section")==null?"":" · "+com.grievancecampus.util.HtmlUtil.escape(g.get("section"))%></p><%if(g.get("location_text")!=null||g.get("latitude")!=null){%><p>Location: <%=com.grievancecampus.util.HtmlUtil.escape(g.get("location_text"))%><%=g.get("latitude")==null?"":" ("+com.grievancecampus.util.HtmlUtil.escape(g.get("latitude"))+", "+com.grievancecampus.util.HtmlUtil.escape(g.get("longitude"))+")"%></p><%}%><%if(g.get("photo_path")!=null){%><img src="../app/photo?id=<%=com.grievancecampus.util.HtmlUtil.escape(g.get("grievance_id"))%>" alt="Grievance evidence" style="max-width:100%;border-radius:12px"><%}%></section><%if(g.get("completion_notes")!=null){%><section class="panel"><h2>Completion notes</h2><p><%=com.grievancecampus.util.HtmlUtil.escape(g.get("completion_notes"))%></p><p>Completed: <%=com.grievancecampus.util.HtmlUtil.escape(g.get("completed_at"))%></p></section><%}%><section class="panel"><h2>Progress history</h2><%if(updates.isEmpty()){%><p>No progress updates yet.</p><%}else{%><ul><%for(Map<String,Object> item:updates){%><li><strong><%=com.grievancecampus.util.HtmlUtil.escape(item.get("status"))%></strong> · <%=com.grievancecampus.util.HtmlUtil.escape(item.get("created_at"))%><%if(item.get("author_name")!=null){%> · <%=com.grievancecampus.util.HtmlUtil.escape(item.get("author_name"))%><%}%><p><%=com.grievancecampus.util.HtmlUtil.escape(item.get("note"))%></p></li><%}%></ul><%}%></section></main></body></html>
